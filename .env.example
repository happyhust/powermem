# =============================================================================
# PowerMem — minimal configuration
# =============================================================================
# These are the ONLY variables you need to start PowerMem. Everything else has
# a safe default, so the system runs out of the box:
#
#   - Database  -> SQLite at ./powermem.db
#   - Embedder  -> built-in local all-MiniLM-L6-v2 (no API key required;
#                  model auto-downloads to ~/.cache on first use)
#   - Vector / graph / reranker / telemetry / audit -> sensible defaults
#
# If you want to tune performance, swap providers, or unlock advanced features,
# copy the comprehensive reference instead:
#
#       cp .env.example.full .env
#
# `.env.example.full` documents every available knob, grouped by component.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider (required for memory extraction / Q&A)
# -----------------------------------------------------------------------------
# PowerMem uses an LLM to extract and update memories. Pick a provider and
# paste its API key below. Supported: qwen, openai, siliconflow, ollama, vllm,
# anthropic, deepseek. (Only `qwen` and `openai` need an API key for cloud use;
# `ollama` / `vllm` run locally and ignore LLM_API_KEY.)
#
# Where to get a key:
#   - Qwen (Aliyun DashScope): https://dashscope.console.aliyun.com/
#   - OpenAI:                  https://platform.openai.com/api-keys
LLM_PROVIDER=qwen
LLM_API_KEY=your_api_key_here
LLM_MODEL=qwen-plus
