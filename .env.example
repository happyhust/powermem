# =============================================================================
# PowerMem — minimal configuration
# =============================================================================
# These are the ONLY variables you need to start PowerMem. Everything else has
# a safe default, so the system runs out of the box:
#
#   - Database  -> OceanBase provider with no host configured, which boots
#                  embedded seekdb on disk at ./seekdb_data (same engine,
#                  same SQL surface, no separate server). Set OCEANBASE_HOST
#                  in `.env.example.full` to point at a remote cluster.
#   - Embedder  -> built-in local all-MiniLM-L6-v2 (no API key required;
#                  model auto-downloads to ~/.cache on first use)
#   - Reranker / graph store / telemetry / audit -> sensible defaults / off
#
# Want higher performance, or does your environment already have stronger
# infrastructure to plug into — a remote OceanBase cluster, a hosted embedding
# LLM, a rerank LLM, etc.? Don't replace this file; just open
# `.env.example.full`, copy the specific config block(s) you need, and paste
# them into your `.env` alongside the keys above.
#
# `.env.example.full` documents every available knob, grouped by component, so
# you can pick exactly what you want and leave the rest at safe defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM (required) — the model PowerMem calls to extract facts from raw input,
# decide what to add/update/skip in memory, and synthesize answers at search
# time. Quality and cost here directly shape the quality of every memory you
# store and every result you retrieve.
# -----------------------------------------------------------------------------
#
# LLM_PROVIDER — which gateway PowerMem talks to.
#   Recommended:  qwen  (good price/quality, fast in CN; works abroad too)
#   Other options: openai, siliconflow, anthropic, deepseek, ollama, vllm
#                  — pick `ollama` / `vllm` if you want fully local inference
#                  with no API key.
#
# LLM_API_KEY — credential for the chosen provider.
#   Ignored for local providers (`ollama`, `vllm`). Where to get one:
#     - Qwen (Aliyun DashScope): https://dashscope.console.aliyun.com/
#     - OpenAI:                  https://platform.openai.com/api-keys
#     - SiliconFlow:             https://siliconflow.cn/
#     - Anthropic:               https://console.anthropic.com/
#
# LLM_MODEL — the specific model to call on that provider.
#   Recommended:  qwen-plus  (balanced quality / latency / cost)
#   Other options for `qwen`:    qwen-max (higher quality, more expensive),
#                                qwen-turbo (cheapest, fast, lower quality)
#   For `openai`:                gpt-4o, gpt-4o-mini, gpt-4-turbo
#   For `anthropic`:             claude-sonnet-4-6, claude-haiku-4-5
#   For `ollama` / `vllm`:       any model you've pulled locally
#                                (e.g. llama3.1:8b, qwen2.5:7b)
LLM_PROVIDER=qwen
LLM_API_KEY=your_api_key_here
LLM_MODEL=qwen-plus
